# Поверхность конфига бота (pydantic-settings). Все значения (включая секреты) —
# обычные env; локально — этот файл скопировать в .env (не коммитится). Секреты помечены [secret].

# ── Telegram (tgbotkit.Config, BOT_*) ────────────────────────────────────────
BOT_TOKEN=                       # [secret] токен бота от @BotFather
BOT_MODE=polling                 # polling | webhook
BOT_PARSE_MODE=HTML
# throttle/dedup
BOT_DEDUP_ENABLED=true
BOT_THROTTLE_RPS=0               # 0 = off
# webhook-режим (в polling игнорируются)
BOT_WEBHOOK_BASE_URL=            # https://bot.example.com
BOT_WEBHOOK_PATH=/tg/webhook
BOT_WEBHOOK_SECRET=              # [secret] X-Telegram-Bot-Api-Secret-Token
# i18n (locales_dir/resources проставляет config.py из пакета; локаль по умолчанию — ru)
BOT_I18N_DEFAULT_LOCALE=ru

# ── приложение (AppConfig, APP_*) ────────────────────────────────────────────
APP_ADMIN_IDS=                   # csv tg_id админов (роль admin), напр. 12345,67890

# ── Redis (cachekit) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── NATS (natskit; включить JetStream для notifications) ──────────────────────
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_ENABLED=true
NATS_JS_STREAM_NAMES=orders

# ── Backend (httpclient) ─────────────────────────────────────────────────────
HTTPCLIENT_BASE_URL=http://localhost:8080
HTTPCLIENT_TIMEOUT=10

# ── Логи (logkit) ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Логи пишутся в stdout (LOG_STDOUT=true по умолчанию) — собираются рантаймом
# контейнера (docker/compose logs).
# LOG_STDOUT=false               # выключить вывод логов в stdout
# LOG_REDACT_ENABLED=true        # редакция чувствительных полей в логах

# ── Deploy-ручки (kit-дефолты годятся; включаются по мере надобности) ─────────
# Health-порт: в polling-режиме бот тоже биндит HTTP_* (health-probe).
# NATS_MAX_RECONNECTS=-1         # -1 = бесконечные reconnect'ы (рекомендовано в проде)
# NATS_JS_MAX_DELIVER=           # poison-handling: лимит redelivery
# NATS_JS_NAK_BACKOFF=           # backoff между redelivery
# NATS_JS_FLOW_CONTROL=          # flow-control push-консьюмера
# NATS_JS_IDLE_HEARTBEAT=        # heartbeat idle-консьюмера
# NATS_JS_DLQ_ENABLED=           # DLQ: dlq.<subject> после MaxDeliver
# BOT_FLOOD_ENABLED=             # анти-флуд middleware
# BOT_RATE_GLOBAL=               # глобальный rate-limit отправки
# BOT_RATE_PER_CHAT=             # per-chat rate-limit
# BOT_RETRY_AFTER_ATTEMPTS=      # ретраи на 429 Retry-After
# BOT_STATE_TTL=                 # TTL FSM-стейта в Redis (0 = вечно)
# HTTPCLIENT_BREAKER_NAME=core   # имя breaker'а (метрики http_client_breaker_*{name})

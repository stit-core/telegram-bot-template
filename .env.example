# Поверхность конфига бота (pydantic-settings, ENV только по именам ниже). Все значения
# (включая секреты) — обычные env; локально — скопировать в .env (не коммитится). Секреты
# помечены [secret]. Заданная, но пустая переменная = незаданная (берётся дефолт кита).
# Невалидное значение валит старт (<kit>.ConfigError), а не первый апдейт.

# ── Telegram (tgbotkit.Config, BOT_*) ────────────────────────────────────────
BOT_TOKEN=                       # [secret] токен бота от @BotFather; ОБЯЗАТЕЛЕН, формат <id>:<secret>
BOT_MODE=polling                 # polling | webhook
BOT_PARSE_MODE=HTML              # HTML | MarkdownV2 | Markdown | "" (без разметки)
# throttle/dedup (общий Redis → корректно при нескольких воркерах)
BOT_DEDUP_ENABLED=true
BOT_THROTTLE_RPS=0               # входящих апдейтов/с на пользователя; 0 = off
# webhook-режим (в polling игнорируются): обязательны https-база и секрет
BOT_WEBHOOK_BASE_URL=            # https://bot.example.com
BOT_WEBHOOK_PATH=/tg/webhook
BOT_WEBHOOK_SECRET=              # [secret] X-Telegram-Bot-Api-Secret-Token, 1..256 из A-Za-z0-9_-
# i18n (каталог и ресурсы проставляет config.py из пакета; локаль по умолчанию — ru)
BOT_I18N_DEFAULT_LOCALE=ru

# ── приложение (AppConfig, APP_*) ────────────────────────────────────────────
APP_ADMIN_IDS=                   # csv tg_id админов (роль admin), напр. 12345,67890; не-число валит старт
# SERVICE_VERSION / GIT_COMMIT — зашивает Dockerfile при make release (лог "starting")

# ── Redis (cachekit, REDIS_*) — обязателен: FSM/диалоги/dedup/лимиты/identity-link ───
REDIS_URL=redis://localhost:6379/0   # [secret] при пароле в URL; Redis >= 7.0
# REDIS_KEY_PREFIX=              # изоляция ключей cachekit при общей БД Redis с другим сервисом

# ── NATS (natskit, NATS_*; JetStream — для notifications) ────────────────────
NATS_URL=nats://localhost:4222   # [secret] при user:password/токене в URL
NATS_JETSTREAM_ENABLED=true      # false → notifications выключены (runner пропускает подписки)
NATS_JS_STREAM_NAMES=orders      # стримы кита (subjects <name>.>)

# ── Backend (httpclient, HTTPCLIENT_*) ───────────────────────────────────────
# ОБЯЗАТЕЛЕН: base_url бэкенда «core». Пустой валит старт контейнера (fail-fast),
# а не первого пользователя.
HTTPCLIENT_BASE_URL=http://localhost:8080
HTTPCLIENT_TIMEOUT=10            # секунды на одну попытку
# Второй бэкенд объявляется декларацией HTTPCLIENT_BACKENDS (JSON; base_url обязателен
# per-backend, глобальные HTTPCLIENT_* в декларации НЕ наследуются), плюс запись в
# config.py:backends. Пример:
# HTTPCLIENT_BACKENDS={"crm": {"base_url": "http://crm:8080", "timeout": 5}}

# ── Логи (logkit, LOG_*) — JSON в stdout, собирает рантайм контейнера ─────────
LOG_LEVEL=info                   # debug | info | warn | error
# LOG_FORMAT=json                # text — human-readable для локальной разработки
# LOG_SILENT=false               # true — локальный sink молчит (записи никуда не идут)
# LOG_SOURCE=false               # true — файл/строка вызывающего в каждой записи
# LOG_REDACT_ENABLED=false       # маски PII/секретов в msg и строковых полях
# LOG_REDACT_PATTERNS=           # свои regex через ';' (пусто = дефолтный набор кита)

# ── Health-порт (httpkit, HTTP_*) — /health и /ready, в webhook ещё и приём апдейтов ──
# HTTP_ADDR=:8080                # bind-адрес; пустой host = все интерфейсы
# HTTP_READY_PROBE_TIMEOUT=5     # потолок одной пробы /ready (getMe, PING, статус NATS)
# HTTP_DOCS_ENABLED=true         # false — без /docs,/redoc,/openapi.json на health-порту

# ── Deploy-ручки (kit-дефолты годятся; включаются по мере надобности) ─────────
# BOT_API_TIMEOUT=60             # таймаут одного вызова Bot API, с
# BOT_SHUTDOWN_TIMEOUT=10        # бюджет дренажа подписок и остановки опроса, с
# BOT_DEDUP_TTL=600              # окно повтора update_id, с
# BOT_STATE_TTL=0                # TTL FSM-стейта и данных диалога в Redis, с (0 = вечно)
# BOT_FLOOD_ENABLED=true         # rate-limit исходящих, порядок в чате, ретрай 429
# BOT_RATE_GLOBAL=30             # исходящих сообщений/с (лимит Telegram)
# BOT_RATE_PER_CHAT=1            # исходящих сообщений/с в один чат
# BOT_RATE_MAX_WAIT=60           # потолок ожидания слота/retry_after одним вызовом, с
# BOT_RETRY_AFTER_ATTEMPTS=3     # повторов вызова после 429
# BOT_DROP_PENDING=false         # отбросить накопленные апдейты при старте
# NATS_MAX_RECONNECTS=-1         # -1 = бесконечные reconnect'ы (дефолт кита, рекомендовано в проде)
# NATS_DRAIN_TIMEOUT=10          # бюджет graceful close соединения NATS, с
# NATS_JS_MAX_DELIVER=10         # poison-handling: лимит redelivery (0 = без лимита)
# NATS_JS_NAK_BACKOFF=1          # секунды NAK-backoff между redelivery (0 = мгновенно)
# NATS_JS_DLQ_SUBJECT=           # DLQ-subject: republish перед term ("" = только term)
# HTTPCLIENT_MAX_RETRIES=3       # retry-бюджет (мутации ретраятся только с Idempotency-Key)
# HTTPCLIENT_BREAKER_FAILURE_THRESHOLD=5  # порог открытия breaker'а на хост бэкенда (0 = off)

# Поверхность конфига бота (pydantic-settings). На проде секреты рендерит vault-agent
# в env; локально — этот файл скопировать в .env (не коммитится). Секреты помечены [secret].

# ── Telegram (tgbotkit.Config, BOT_*) ────────────────────────────────────────
BOT_TOKEN=                       # [secret] токен бота от @BotFather
BOT_MODE=polling                 # polling | webhook
BOT_PARSE_MODE=HTML
# throttle/dedup
BOT_DEDUP_ENABLED=true
BOT_THROTTLE_RPS=0               # 0 = off
# webhook-режим (в polling игнорируются)
BOT_WEBHOOK_BASE_URL=            # https://bot.example.com
BOT_WEBHOOK_PATH=/tg/webhook
BOT_WEBHOOK_SECRET=              # [secret] X-Telegram-Bot-Api-Secret-Token
# i18n (locales_dir/resources проставляет config.py из пакета; локаль по умолчанию — ru)
BOT_I18N_DEFAULT_LOCALE=ru

# ── приложение (AppConfig, APP_*) ────────────────────────────────────────────
APP_ADMIN_IDS=                   # csv tg_id админов (роль admin), напр. 12345,67890

# ── Redis (cachekit) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── NATS (natskit; включить JetStream для notifications) ──────────────────────
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_ENABLED=true
NATS_JS_STREAM_NAMES=orders

# ── Backend (httpclient) ─────────────────────────────────────────────────────
HTTPCLIENT_BASE_URL=http://localhost:8080
HTTPCLIENT_TIMEOUT=10

# ── Observability (telemetry/logkit) ─────────────────────────────────────────
OTEL_SERVICE_NAME=telegram-bot
OTEL_SERVICE_VERSION=dev
APP_ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
LOG_LEVEL=info
# Логи всегда в stdout (LOG_STDOUT=true по умолчанию). Метрики/трейсы — только в
# OTLP; без локального коллектора молча дропаются.
# LOG_STDOUT=false               # выключить дублирование логов в stdout

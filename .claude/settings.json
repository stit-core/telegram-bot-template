{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(make fmt)",
      "Bash(make lint*)",
      "Bash(make typecheck)",
      "Bash(make test*)",
      "Bash(make check)",
      "Bash(make run)",
      "Bash(make status*)",
      "Bash(make setup)",
      "Bash(make lock)",
      "Bash(make sync)",
      "Bash(make release*)",
      "Bash(make help)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pytest*)",
      "Bash(uv run lint-imports*)",
      "Bash(uv run python -m bot*)",
      "Bash(uv lock*)",
      "Bash(uv sync*)",
      "Bash(uv add*)",
      "Bash(docker buildx*)",
      "Bash(docker compose -f compose.dev.yml*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git tag -l*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(*--no-gpg-sign*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(.env)",
      "Read(.env.local)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(uv.lock)",
      "Write(**/.claude/projects/**/memory/**)",
      "Edit(**/.claude/projects/**/memory/**)",
      "MultiEdit(**/.claude/projects/**/memory/**)"
    ]
  }
}

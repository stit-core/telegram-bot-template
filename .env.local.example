# .env.local.example — шаблон dev-tooling кредов.
# Скопируй в .env.local (gitignored) и подставь реальные значения.
# .env.local НЕ коммитится (.gitignore).
#
# Это НЕ runtime-секреты бота. Runtime app env — в .env для `make run`,
# на VPS — Vault + vault-agent (см. infra-repo). Здесь — токены для
# dev-инструментов:
#   - чтение прод-логов: scripts/tools/logs.sh / скилл query-logs (STIT_OBS_TOKEN)
#
# Формат: KEY=value, по строке на секрет. Парсится grep'ом, не sourcing'ом —
# без многострочных значений и без $-подстановок. Значение токена в чат не
# вытаскивать — tools читают файл сами и не эхо-ят секрет (rule env-local).

# Bearer для корп-observability (Loki/Tempo/OTLP edge). Tenant зашит в токене.
# Источник: корп-Vault kv/projects/<project>/<env>/otel — там же ротация.
STIT_OBS_TOKEN=replace-me

# Адрес корп-Loki read API для logs.sh / query-logs. Обязателен (logs.sh
# падает с FAIL при пустом — не уходим молча на managed-хост).
#   managed:     https://loki.stit.tech
#   self-hosted: свой Loki из форка corp-infra-template
STIT_LOKI_ADDR=https://loki.stit.tech

# Tenant для e2e otel-agent (make test-integration). Совпадает с
# service_namespace (корп-инвариант service_namespace == tenant).
OTEL_TENANT=replace-me
